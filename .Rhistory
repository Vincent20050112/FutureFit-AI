# Contingency Table
n11 = 30
n12 = 20
n21 = 25
n22 = 35
# Estimate of pi hat
pi1_hat = n11 / (n11 + n12)
pi2_hat = n21 / (n21 + n22)
diff_pi_hat = pi1_hat - pi2_hat
alpha = qnorm(0.975)
se_diff = sqrt( pi1_hat*(1-pi1_hat)/(n11 + n12) + pi2_hat*(1-pi2_hat)/(n21 + n22) )
print(diff_pi_hat + c(-1, 1) * alpha * se_diff)
theta_hat = (n11 / n12) / (n21 / n22)
alpha = qnorm(0.975)
se_log_theta_hat = sqrt( 1/n11 + 1/n12 + 1/n21 + 1/n22)
print(exp(log(theta_hat) + c(-1,1) * alpha * se_log_theta_hat))
